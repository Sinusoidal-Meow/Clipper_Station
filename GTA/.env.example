# ClipForge Configuration
# Copy this file to .env and fill in your values

# Token encryption key (generate with: python -m clipforge gen-key)
TOKEN_ENCRYPTION_KEY=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Gemini API (optional, for enhanced metadata)
GEMINI_API_KEY=

# Public URL for Instagram publishing (optional)
PUBLIC_MEDIA_BASE_URL=http://localhost:8800

# Enable auto-publishing (0 or 1)
CLIPOPS_PUBLISH_ENABLED=0