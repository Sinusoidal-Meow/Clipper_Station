# Clip Operations Center - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# Required for token encryption (generate with: clipops gen-key)
# ============================================================
TOKEN_ENCRYPTION_KEY=your-generated-key-here

# ============================================================
# Optional: Gemini enhancement for better titles/scores
# ============================================================
GEMINI_API_KEY=

# ============================================================
# YouTube Data API v3 + Analytics (OAuth Desktop app)
# Create at: https://console.cloud.google.com/apis/credentials
# ============================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ============================================================
# Instagram Publishing (requires Cloudflare Tunnel)
# Run: cloudflared tunnel --url http://127.0.0.1:8765
# ============================================================
PUBLIC_MEDIA_BASE_URL=http://localhost:8765

# ============================================================
# Publishing control (set to 1 to enable uploads)
# Keep 0 during testing, set to 1 after manual verification
# ============================================================
CLIPOPS_PUBLISH_ENABLED=0